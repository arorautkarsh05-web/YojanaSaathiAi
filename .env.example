# YojanaSaathi AI Environment Configuration
PROJECT_NAME="YojanaSaathi AI"
VERSION="3.0.0"
ENV="development"
DEBUG=True

# Database URL
# In local development, SQLite is used by default:
DATABASE_URL="sqlite:///./yojanasaathi.db"
# For production PostgreSQL:
# DATABASE_URL="postgresql://yojanasaathi_user:secure_password@localhost:5432/yojanasaathi_db"

# Authentication & Cryptographic Secrets
SECRET_KEY="generate-a-secure-32-character-random-key-for-production"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Cookie Security (set to True on HTTPS domains)
COOKIE_SECURE=False
COOKIE_SAMESITE="lax"

# LLM Provider Key (Optional / Used only for non-eligibility translation and intake assistance)
# GEMINI_API_KEY=""

